{
  "env": {
    "CREW_AGENT": "claude"
  },
  "permissions": {
    "allow": [
      "Bash(crew:*)",
      "Bash(crew.cmd:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "mcp__crew"
    ]
  },
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/ECC.git"
      }
    }
  },
  "enabledPlugins": {
    "ecc@ecc": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/crew-cloud-setup.mjs\""
          }
        ]
      }
    ]
  }
}
