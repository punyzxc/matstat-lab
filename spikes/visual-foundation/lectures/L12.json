      "title": "Errors of two kinds",
      "idea": "A test rejects a true $H_0$ with probability $\\alpha$ and keeps a false $H_0$ with probability $\\beta$; the power is $1 - \\beta$.",
      "formula": [
        "\\alpha = P(\\text{reject } H_0 \\mid H_0)",
        "\\beta = P(\\text{keep } H_0 \\mid H_1)"
      ],
      "experiment": {
        "station": "testing",
        "seed": 1212,
        "params": {
          "sigmaKnown": 1,
          "a0": 0,
          "mu": 0.5,
          "sigma": 1,
          "n": 16,
          "tail": 1,
          "truth": 1
        }
      }
    },
    {
      "title": "Comparing variances",
      "idea": "The ratio of two sample variances follows the Fisher–Snedecor $F$ law under $H_0$.",
      "formula": [
        "F = \\dfrac{s_1^2}{s_2^2}"
      ],
